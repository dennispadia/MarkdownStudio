<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lekh: Markdown editor Setup" Width="704" SizeToContent="Height" MinWidth="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="#171919" Foreground="#E6E9E5" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#233936"/>
      <Setter Property="Foreground" Value="#E6E9E5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#80BFB8"/><Setter Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#354044" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid>
      <Ellipse Width="460" Height="80" Fill="#80BFB8" Opacity="0.16" VerticalAlignment="Bottom" Margin="0,0,0,-60" IsHitTestVisible="False">
        <Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect>
      </Ellipse>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
          <TextBlock x:Name="PreviewBadge" Visibility="Collapsed" Margin="16,8" Foreground="#ABB6AC" FontSize="11" Text="Design preview - does not install"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,8,3">
            <Button x:Name="Minimize" Content="&#x2212;" Padding="10,0" MinHeight="28" Width="36" Background="Transparent" AutomationProperties.Name="Minimize setup"/>
            <Button x:Name="CloseWindow" Content="&#x00D7;" Padding="10,0" MinHeight="28" Width="36" Background="Transparent" AutomationProperties.Name="Close setup"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="36,4,36,30">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,38">
              <Image x:Name="Logo" Width="64" Height="64" Margin="0,0,16,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock><Run Text="Lekh" FontFamily="Segoe UI Light" FontSize="30" FontWeight="Light"/><Run Text="  लेख" FontFamily="Nirmala UI" FontSize="17"/></TextBlock>
                <TextBlock Text="Markdown editor" Foreground="#ABB6AC" FontSize="12" Margin="0,2,0,0"/>
                <TextBlock x:Name="VersionLabel" Text="WINDOWS SETUP" Foreground="#ABB6AC" FontSize="10" Margin="0,5,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StateMark" Text="YOUR WRITING DESK" Foreground="#80BFB8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="Heading" Text="A quieter place to write." FontSize="29" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,12"
                       AutomationProperties.AutomationId="Heading" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="Description" Foreground="#ABB6AC" LineHeight="22" TextWrapping="Wrap" MinHeight="44" AutomationProperties.AutomationId="Description"/>
            <TextBlock x:Name="Benefits" Text="Windows x64    /    Offline setup    /    Just for you" Foreground="#ABB6AC" FontSize="11" Margin="0,20,0,0"/>
            <Border x:Name="StoryArea" Visibility="Collapsed" BorderBrush="#35413E" BorderThickness="1" CornerRadius="8" Padding="20,17" Margin="0,22,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="THE STORY OF LEKH" Foreground="#80BFB8" FontSize="10"/>
                  <TextBlock x:Name="StoryCount" HorizontalAlignment="Right" Foreground="#ABB6AC" FontSize="11" AutomationProperties.AutomationId="StoryCount"/>
                </Grid>
                <TextBlock x:Name="StoryTitle" FontFamily="Segoe UI Light" FontSize="21" Margin="0,0,0,10"/>
                <Grid>
                  <TextBlock x:Name="StoryAccessible" Visibility="Hidden" MinHeight="90" FontSize="14" LineHeight="24" TextWrapping="Wrap" AutomationProperties.AutomationId="StoryAccessible"/>
                  <TextBlock x:Name="StoryWritten" MinHeight="90" FontSize="14" LineHeight="24" TextWrapping="Wrap" Foreground="#ABB6AC"
                             AutomationProperties.AutomationId="StoryWritten">
                    <Run x:Name="StoryInk"/>
                    <InlineUIContainer BaselineAlignment="Center">
                      <Viewbox x:Name="StoryQuill" Width="24" Height="24" Margin="4,0,0,0">
                        <Canvas Width="240" Height="240">
                          <Path Data="M79 160C72 114 98 76 170 53c7 57-20 97-76 108Z" Fill="#275950" Stroke="#80BFB8" StrokeThickness="5"/>
                          <Path Data="M64 185L150 79M95 153L137 101" Stroke="#E6EEE4" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                      </Viewbox>
                    </InlineUIContainer>
                  </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                  <Button x:Name="StoryPrevious" Content="Previous" Padding="10,5" MinHeight="28" FontSize="11" AutomationProperties.AutomationId="StoryPrevious" AutomationProperties.Name="Previous story chapter"/>
                  <Button x:Name="StoryPause" Content="Pause story" Padding="10,5" MinHeight="28" FontSize="11" AutomationProperties.AutomationId="StoryPause"/>
                  <Button x:Name="StoryNext" Content="Next" Padding="10,5" MinHeight="28" FontSize="11" AutomationProperties.AutomationId="StoryNext" AutomationProperties.Name="Next story chapter"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,25,0,0">
              <ProgressBar x:Name="Progress" Height="5" Maximum="100" Foreground="#80BFB8" Background="#35413E" BorderThickness="0"
                           AutomationProperties.Name="Windows Installer stage progress"/>
              <TextBlock x:Name="Stages" Text="Prepare     /     Install     /     Finish" Foreground="#80BFB8" FontSize="11" Margin="0,13,0,0" AutomationProperties.AutomationId="Stages"/>
              <TextBlock x:Name="ProgressCaption" Foreground="#ABB6AC" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border x:Name="NoticeArea" BorderBrush="#80BFB8" BorderThickness="2,0,0,0" Padding="13,0,0,0" Margin="0,20,0,0" Visibility="Collapsed">
              <TextBlock x:Name="Notice" Foreground="#ABB6AC" FontSize="12" LineHeight="20" TextWrapping="Wrap" AutomationProperties.AutomationId="Notice"/>
            </Border>
            <Expander x:Name="Details" Header="Technical details and logs" Foreground="#80BFB8" Margin="0,16,0,0" Visibility="Collapsed">
              <StackPanel Margin="0,10,0,0">
                <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="#171919" Foreground="#ABB6AC" FontSize="11"/>
                <Button x:Name="OpenLog" Content="Open setup logs" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#2B3639" BorderThickness="0,1,0,0" Padding="36,19,36,23">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Assurance" Foreground="#93A099" FontSize="10" LineHeight="16" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="Secondary" Content="Not now" Background="Transparent" Foreground="#ABB6AC"/>
              <Button x:Name="Primary" Content="Install Lekh" Background="#80BFB8" Foreground="#142624" FontWeight="SemiBold"
                      IsDefault="True" AutomationProperties.AutomationId="Primary"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
